# Supabase project values from Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional deployment base. GitHub Actions gets this from GitHub Pages.
# Use /dndplayer/ for the default project site, or / for a custom/root domain.
VITE_BASE_PATH=/dndplayer/

# Never place a secret key or service_role key in a VITE_ variable.

# Optional Cloudflare Worker that serves heavy Wayfinder assets from R2.
# Leave blank until the Worker is deployed; Supabase Storage remains the fallback.
VITE_ASSET_API_URL=
